NODE_ENV=development
DATABASE_URL=postgresql://root:admin@localhost:5432/udhari
JWT_TOKEN=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:3000
# Leave blank locally. For app/API subdomains in deployment, use the shared parent domain.
# Example: COOKIE_DOMAIN=.udhari.in
COOKIE_DOMAIN=

# Razorpay Standard Checkout (backend only). Never expose the secret to a client.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me



# Google Play Billing (backend only). Keep the service account JSON on one line.
GOOGLE_PLAY_PACKAGE_NAME=com.udhari.app


# SMTP email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASS=replace-with-your-smtp-password
EMAIL_TRANSPORT="Udhari <noreply@example.com>"
