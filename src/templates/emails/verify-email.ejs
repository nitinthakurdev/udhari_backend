<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Verify your Udhari account</title>
  </head>
  <body style="margin: 0; background: #f5f7fb; font-family: Arial, sans-serif; color: #172033">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="padding: 32px 16px">
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="100%"
            cellspacing="0"
            cellpadding="0"
            style="max-width: 560px; background: #ffffff; border-radius: 12px; padding: 40px"
          >
            <tr>
              <td>
                <h1 style="margin: 0 0 20px; font-size: 26px">Verify your email address</h1>
                <p style="margin: 0 0 16px; font-size: 16px; line-height: 1.6">Hi <%= name %>,</p>
                <p style="margin: 0 0 28px; font-size: 16px; line-height: 1.6">
                  Thanks for creating your Udhari account. Confirm your email address to activate
                  your account and sign in.
                </p>
                <a
                  href="<%= verificationUrl %>"
                  style="display: inline-block; background: #2563eb; color: #ffffff; padding: 14px 24px; border-radius: 8px; text-decoration: none; font-weight: bold"
                >Verify my account</a>
                <p style="margin: 28px 0 0; color: #667085; font-size: 14px; line-height: 1.6">
                  This link expires in 24 hours. If you did not create this account, you can safely
                  ignore this email.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
