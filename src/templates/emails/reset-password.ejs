<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reset your Udhari password</title>
  </head>
  <body style="margin: 0; background: #f5f7fb; font-family: Arial, sans-serif; color: #172033">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="padding: 32px 16px">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width: 560px; background: #ffffff; border-radius: 12px; padding: 40px">
            <tr>
              <td>
                <h1 style="margin: 0 0 20px; font-size: 26px">Reset your password</h1>
                <p style="margin: 0 0 16px; font-size: 16px; line-height: 1.6">Hi <%= name %>,</p>
                <p style="margin: 0 0 28px; font-size: 16px; line-height: 1.6">We received a request to reset your Udhari password.</p>
                <a href="<%= resetUrl %>" style="display: inline-block; background: #2563eb; color: #ffffff; padding: 14px 24px; border-radius: 8px; text-decoration: none; font-weight: bold">Reset my password</a>
                <p style="margin: 28px 0 0; color: #667085; font-size: 14px; line-height: 1.6">This one-time link expires in 1 hour. If you did not request a password reset, you can safely ignore this email.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
